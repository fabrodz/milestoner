{
  "name": "milestoner",
  "version": "0.5.0",
  "description": "Supervised autonomous-run engine for coding agents: milestone state machine, evidence gates, infra-failure discrimination.",
  "keywords": ["claude-code", "agents", "autonomous", "orchestrator", "milestones"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/fabrodz/milestoner.git" },
  "homepage": "https://github.com/fabrodz/milestoner#readme",
  "bugs": { "url": "https://github.com/fabrodz/milestoner/issues" },
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "milestoner": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "gen:skill": "node --import tsx scripts/gen-skill.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "check:manifests": "node scripts/check-manifests.mjs",
    "build": "npm run gen:skill && npm run sync:version && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
